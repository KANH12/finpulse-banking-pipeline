# Application
APP_ENV=development
LOG_LEVEL=INFO

# AWS and S3 storage
# Use an IAM user/role with read/write access to the configured bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-2
S3_BUCKET=finpulse-lake

# Micro-batch ingestion
BATCH_SIZE=10
EVENTBRIDGE_RULE_NAME=finpulse-ingestion-trigger

# Set to true when EventBridge Scheduler manages invocations in AWS.
# This prevents the producer from disabling the schedule when the source is exhausted.
SCHEDULER_MANAGED=false

# Required only by scripts/deploy_aws.py after an image is pushed to ECR.
# FINPULSE_IMAGE_URI=123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/finpulse-microbatch-pipeline:latest
