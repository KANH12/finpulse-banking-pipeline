# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Broker / Streaming Configuration (Redpanda / Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=banking.transactions.raw
KAFKA_QUARANTINE_TOPIC=banking.transactions.dlq

# Storage & Database
DUCKDB_PATH=data/warehouse.duckdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Stream Simulation Settings
REPLAY_SPEED_MULTIPLIER=10
FAULT_INJECTION_RATE=0.05
